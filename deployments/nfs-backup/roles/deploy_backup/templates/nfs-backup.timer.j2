# Generated by Ansible. One copy is rendered for backup, prune, and check.
#
# A timer is only a lightweight schedule. It does not contain Restic and does
# not keep a Docker container alive. At OnCalendar, it asks systemd to start the
# one-shot service named by Unit below.

[Unit]
Description=Schedule NFS Restic {{ item.value.description }}

[Timer]
# Include an explicit timezone so daylight-saving changes and host timezone do
# not silently move the intended wall-clock schedule.
OnCalendar={{ item.value.calendar }} {{ nfs_backup.timezone }}
# false means a schedule missed while powered off is not replayed at boot.
# Set nfs_backup.persistent_timers=true to enable one catch-up activation.
Persistent={{ nfs_backup.persistent_timers | ternary('true', 'false') }}
# Ask systemd to stay within one second of the configured wall-clock time rather
# than coalescing this timer into a broader power-saving window.
AccuracySec=1s
# item.key becomes backup, prune, or check and fills `%i` in the template unit.
Unit=nfs-backup@{{ item.key }}.service

[Install]
# `systemctl enable` attaches this timer to the standard system timer target so
# it becomes active after future boots.
WantedBy=timers.target
