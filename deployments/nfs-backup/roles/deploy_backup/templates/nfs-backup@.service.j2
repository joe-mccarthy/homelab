# Generated by Ansible. Edit the source template, not the installed unit.
#
# This is a systemd TEMPLATE service. The `%i` token becomes the instance name:
#
#   nfs-backup@backup.service -> nfs-backup-job backup
#   nfs-backup@prune.service  -> nfs-backup-job prune
#   nfs-backup@check.service  -> nfs-backup-job check

[Unit]
Description=Run NFS Restic %i job
Documentation=https://restic.readthedocs.io/
# Network and Docker must be available before an S3-backed container can run.
Wants=network-online.target
After=network-online.target docker.service
# Starting this unit also starts Docker; stopping Docker stops the job.
Requires=docker.service

[Service]
# A oneshot service is expected to perform work and exit. systemd does not try
# to keep it running after the Restic command finishes.
Type=oneshot
ExecStart=/usr/local/sbin/nfs-backup-job %i
# Large first backups and repository maintenance can legitimately exceed the
# normal systemd service startup timeout.
TimeoutStartSec=infinity
# Files created directly by the host-side wrapper default to root-only access.
UMask=0077
