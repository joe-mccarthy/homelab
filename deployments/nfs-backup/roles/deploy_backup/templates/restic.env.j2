# Generated by Ansible at {{ nfs_backup.config_path }}/restic.env with mode 0600.
# Docker's --env-file parser ignores lines beginning with `#`.
# Never publish or paste the rendered file: it contains S3 credentials.

# Restic reads repository location and encryption password from mounted files.
# The values themselves therefore do not appear directly in this env file.
RESTIC_REPOSITORY_FILE=/run/secrets/restic-repository
RESTIC_PASSWORD_FILE=/run/secrets/restic-password

# Cache repository metadata on the host across short-lived containers.
RESTIC_CACHE_DIR=/root/.cache/restic

# Maximum compression trades more CPU during backup for lower object storage
# usage and network transfer. Existing blobs are not recompressed automatically.
RESTIC_COMPRESSION=max

# Credentials and region consumed by Restic's S3 backend.
AWS_DEFAULT_REGION={{ nfs_backup.s3.region }}
AWS_ACCESS_KEY_ID={{ nfs_backup.s3.key_id }}
AWS_SECRET_ACCESS_KEY={{ nfs_backup.s3.access_key }}

# Controls timestamps printed by processes inside the temporary container.
TZ={{ nfs_backup.timezone }}
